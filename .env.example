# Required in production only when a durable writable volume is attached.
APPLICATION_STORAGE_ENABLED=false

# Recommended: save new applications directly to the Notion database.
# Share "Sponsorship Applications" with your Notion integration first.
# Never commit the real private key.
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=92bacfd7-b355-4476-8862-aa93a1413a4f

# Public project settings (safe to ship to browsers; row security still required).
# Set these at build time for this statically exported preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do not put a Supabase secret/service-role key in NEXT_PUBLIC_* variables.
# A server-side Notion sync will use secrets inside Supabase Edge Functions,
# never in this website's static build.
